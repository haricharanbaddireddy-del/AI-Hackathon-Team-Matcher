    {
      "parameters": {
        "jsCode": "const students = $input.all().map(item => item.json);\n\n// group students by team\nconst teams = {};\n\nfor (const student of students) {\n  if (!teams[student.team_name]) {\n    teams[student.team_name] = [];\n  }\n\n  teams[student.team_name].push(student);\n}\n\nlet emails = [];\n\nfor (const teamName in teams) {\n\n  const members = teams[teamName];\n\n  let teamDetails = \"\";\n\n  members.forEach((m, index) => {\n    teamDetails += `\n<b>${index + 1}. ${m.name}</b><br>\nRole: ${m.role}<br>\nEmail: ${m.email}<br>\nPhone: ${m.phone}<br><br>\n`;\n  });\n\n  for (const member of members) {\n\n    emails.push({\n      json: {\n        email: member.email,\n        name: member.name,\n        phone: member.phone,\n        role: member.role,\n        team_name: teamName,\n        message: `\nHello ${member.name},<br><br>\n\nYour AI Hackathon team has been created 🎉<br><br>\n\n<b>Team:</b> ${teamName}<br><br>\n\n<b>Your Team Members:</b><br><br>\n\n${teamDetails}\n\nAll the best 🚀\n`\n      }\n    });\n\n  }\n}\n\nreturn emails;"
      },
