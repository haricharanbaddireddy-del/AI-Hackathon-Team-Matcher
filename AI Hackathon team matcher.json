    {
      "parameters": {
        "jsCode": "let rawText = $input.first().json.text;\n\n// Strip markdown code fences if present\nrawText = rawText.replace(/^```json\\s*\\n?/i, '').replace(/\\n?```\\s*$/i, '');\n\nconst aiOutput = JSON.parse(rawText);\n\nlet students = [];\n\nfor (const team of aiOutput.teams) {\n  for (const member of team.members) {\n    students.push({\n      json: {\n        team_name: team.team_name,\n        name: member.name,\n        email: member.email,\n        phone: member.phone,\n        role: member.role\n      }\n    });\n  }\n}\n\nreturn students;"
      },
